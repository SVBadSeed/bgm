# Публичный адрес Directus (браузер + SSR по умолчанию)
NUXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# Адрес сайта (для canonical/og:url)
NUXT_PUBLIC_SITE_URL=http://localhost:3000
# true — верстать на моках, не трогая Directus
NUXT_PUBLIC_USE_MOCK=false
# Ключ чата Teletype (кабинет виджета). Пусто — чат не подключается
NUXT_PUBLIC_TELETYPE_ID=

# Только сервер. Внутри docker-сети Directus доступен по имени сервиса:
# NUXT_DIRECTUS_INTERNAL_URL=http://directus:8055
# Статический токен пользователя с правом create на subscribers/leads (необязательно —
# без него формы пишут через public-права)
# NUXT_DIRECTUS_TOKEN=
