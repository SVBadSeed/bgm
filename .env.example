# ---- Directus (docker compose) ----------------------------------------------
# Скопируй в .env и поменяй пароли. Ключи генерируй: openssl rand -hex 32
DIRECTUS_PORT=8055
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_KEY=replace-with-random-hex-32
DIRECTUS_SECRET=replace-with-random-hex-32

DIRECTUS_ADMIN_EMAIL=admin@bogematur.ru
DIRECTUS_ADMIN_PASSWORD=admin12345

# Postgres для Directus. Порт 5433 наружу, чтобы не драться с bogema-backend (5432).
DB_PORT=5433
DB_DATABASE=bogema_landing
DB_USER=directus
DB_PASSWORD=directus

# Откуда Nuxt ходит в Directus (CORS)
FRONTEND_ORIGIN=http://localhost:3000
